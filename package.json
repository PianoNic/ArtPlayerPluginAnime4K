{
  "name": "artplayer-plugin-anime4k",
  "version": "0.1.3",
  "description": "Real-time Anime4K upscaling for ArtPlayer, on WebGPU. Auto-benchmarks the device, steps down when the GPU cannot keep up.",
  "keywords": [
    "artplayer",
    "artplayer-plugin",
    "anime4k",
    "webgpu",
    "upscaling",
    "super-resolution",
    "anime",
    "video"
  ],
  "license": "MIT",
  "author": "PianoNic",
  "repository": {
    "type": "git",
    "url": "https://github.com/PianoNic/ArtPlayerPluginAnime4K.git"
  },
  "homepage": "https://github.com/PianoNic/ArtPlayerPluginAnime4K#readme",
  "bugs": {
    "url": "https://github.com/PianoNic/ArtPlayerPluginAnime4K/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/artplayer-plugin-anime4k.js",
  "jsdelivr": "./dist/artplayer-plugin-anime4k.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./global": "./dist/artplayer-plugin-anime4k.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --open /demo/",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,html,css,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,md,json,yml}\""
  },
  "packageManager": "bun@1.3.5",
  "dependencies": {
    "anime4k-webgpu-async": "^3.2.0"
  },
  "peerDependencies": {
    "artplayer": "^5.0.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "artplayer": "^5.4.0",
    "hls.js": "^1.7.3",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
